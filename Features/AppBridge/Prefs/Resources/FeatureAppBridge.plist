<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Bridge page. Labels and footers are keys into <lang>.lproj/AppBridge.strings; keys are the AB_KEY_* of
     ../../AppBridge.h. No actions, so the page is a plain OMCFeatureListController. -->
<plist version="1.0">
<dict>
	<key>featureLabel</key>
	<string>APPBRIDGE</string>
	<key>featureOrder</key>
	<integer>40</integer>
	<key>featureController</key>
	<string>OMCFeatureListController</string>
	<key>featureSymbol</key>
	<string>iphone</string>
	<key>featureSymbolColor</key>
	<string>#8A47E8</string>
	<key>title</key>
	<string>App Bridge</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>APPBRIDGE_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>APPBRIDGE_ENABLE</string>
			<key>symbol</key>
			<string>power</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>appBridgeEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>APPBRIDGE_ZOOM</string>
			<key>footerText</key>
			<string>APPBRIDGE_ZOOM_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>appBridgeZoom</string>
			<key>default</key>
			<integer>80</integer>
			<key>min</key>
			<integer>60</integer>
			<key>max</key>
			<integer>100</integer>
			<key>showValue</key>
			<true/>
			<key>isSegmented</key>
			<true/>
			<key>segmentCount</key>
			<integer>8</integer>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
	</array>
</dict>
</plist>
