/* OmniCar – App Bridge – English */

"APPBRIDGE" = "App Bridge";
"APPBRIDGE_FOOTER" = "Shows iPhone apps that have no CarPlay interface (YouTube, TikTok, Netflix...) on the car screen, hosted by OmniCar itself - no CarBridge needed. Split Screen uses it for its iPhone-app boxes: pick any iPhone app for a box, drag the divider and the app relayouts to the new size, and several iPhone apps can be shown at once.";
"APPBRIDGE_ENABLE" = "Enable App Bridge";
"APPBRIDGE_ZOOM" = "App size (%)";
"APPBRIDGE_ZOOM_FOOTER" = "The app is rendered a little larger than its box and scaled down, so iPhone text and buttons stay a comfortable size on the car screen. 100 = no scaling. Applies the next time an app is opened in a box.";
