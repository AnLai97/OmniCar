<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Startup Screen page. Labels and footers are keys into <lang>.lproj/StartupScreen.strings. Keys are the
     SS_KEY_* of ../../StartupScreen.h. "Add video" asks Photos or Files (OMCStartupScreenController addVideo). -->
<plist version="1.0">
<dict>
	<key>featureLabel</key>
	<string>STARTUPSCREEN</string>
	<key>featureOrder</key>
	<integer>10</integer>
	<key>featureController</key>
	<string>OMCStartupScreenController</string>
	<key>featureSymbol</key>
	<string>play.rectangle.fill</string>
	<key>title</key>
	<string>Startup Screen</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_ENABLE</string>
			<key>key</key>
			<string>startupScreenEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>STARTUPSCREEN_VIDEO_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>id</key>
			<string>videoName</string>
			<key>dynamicTitles</key>
			<true/>
			<key>label</key>
			<string>STARTUPSCREEN_CURRENT_VIDEO</string>
			<key>key</key>
			<string>startupScreenVideoName</string>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_ADD</string>
			<key>action</key>
			<string>addVideo</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_PREVIEW</string>
			<key>action</key>
			<string>previewVideo</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_DELETE</string>
			<key>action</key>
			<string>deleteVideo</string>
			<key>isDestructive</key>
			<true/>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_DURATION_GROUP</string>
			<key>footerText</key>
			<string>STARTUPSCREEN_DURATION_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>startupScreenDuration</string>
			<key>default</key>
			<real>5</real>
			<key>min</key>
			<real>1</real>
			<key>max</key>
			<real>30</real>
			<key>showValue</key>
			<true/>
			<key>isSegmented</key>
			<true/>
			<key>segmentCount</key>
			<integer>29</integer>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_PLAY_FULL</string>
			<key>key</key>
			<string>startupScreenPlayFull</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_DISPLAY_GROUP</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>key</key>
			<string>startupScreenScaleMode</string>
			<key>default</key>
			<integer>0</integer>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>STARTUPSCREEN_SCALE_FILL</string>
				<string>STARTUPSCREEN_SCALE_FIT</string>
			</array>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_SOUND</string>
			<key>key</key>
			<string>startupScreenSound</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>STARTUPSCREEN_TAP_TO_SKIP</string>
			<key>key</key>
			<string>startupScreenTapToSkip</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
	</array>
</dict>
</plist>
