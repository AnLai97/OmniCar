<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Split Screen page. Labels and footers are keys into <lang>.lproj/SplitScreen.strings. Keys are the
     SPL_KEY_* of ../../SplitScreen.h. Each favorite layout is one row (OMCSplitFavCell: name, apps, layout
     picture) opening its own page (SplitScreenFav<n>.plist); the usage text lives in SplitScreenGuide.plist. -->
<plist version="1.0">
<dict>
	<key>featureLabel</key>
	<string>SPLITSCREEN</string>
	<key>featureOrder</key>
	<integer>30</integer>
	<key>featureController</key>
	<string>OMCSplitScreenController</string>
	<key>featureSymbol</key>
	<string>rectangle.split.2x1.fill</string>
	<key>title</key>
	<string>Split Screen</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SPLITSCREEN_ENABLE</string>
			<key>key</key>
			<string>splitScreenEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<!-- Options below the on/off switch, in their own group -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>SPLITSCREEN_DRIVER_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SPLITSCREEN_AUTO_LAUNCH</string>
			<key>key</key>
			<string>splitScreenAutoLaunch</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>label</key>
			<string>SPLITSCREEN_DRIVER_SIDE</string>
			<key>key</key>
			<string>splitScreenDriverSide</string>
			<key>default</key>
			<integer>0</integer>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>SPLITSCREEN_DRIVER_AUTO</string>
				<string>SPLITSCREEN_DRIVER_LEFT</string>
				<string>SPLITSCREEN_DRIVER_RIGHT</string>
			</array>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>cellClass</key>
			<string>OMCSplitScreenAppLinkCell</string>
			<key>detail</key>
			<string>OMCSplitScreenAppPickerController</string>
			<key>label</key>
			<string>SPLITSCREEN_PINNED</string>
			<key>key</key>
			<string>splitScreenPinnedApp</string>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>SPLITSCREEN_PANEL_GROUP</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SPLITSCREEN_SHOW_RECENT</string>
			<key>key</key>
			<string>splitScreenShowRecent</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SPLITSCREEN_SHOW_FAVORITES</string>
			<key>key</key>
			<string>splitScreenShowFavorites</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>SPLITSCREEN_FAV_GROUP</string>
			<key>footerText</key>
			<string>SPLITSCREEN_FAV_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>cellClass</key>
			<string>OMCSplitFavCell</string>
			<key>detail</key>
			<string>OMCSplitScreenController</string>
			<key>plist</key>
			<string>SplitScreenFav1</string>
			<key>favIndex</key>
			<integer>1</integer>
			<key>label</key>
			<string>SPLITSCREEN_FAV1_PLACEHOLDER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>cellClass</key>
			<string>OMCSplitFavCell</string>
			<key>detail</key>
			<string>OMCSplitScreenController</string>
			<key>plist</key>
			<string>SplitScreenFav2</string>
			<key>favIndex</key>
			<integer>2</integer>
			<key>label</key>
			<string>SPLITSCREEN_FAV2_PLACEHOLDER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>cellClass</key>
			<string>OMCSplitFavCell</string>
			<key>detail</key>
			<string>OMCSplitScreenController</string>
			<key>plist</key>
			<string>SplitScreenFav3</string>
			<key>favIndex</key>
			<integer>3</integer>
			<key>label</key>
			<string>SPLITSCREEN_FAV3_PLACEHOLDER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>detail</key>
			<string>OMCFeatureListController</string>
			<key>plist</key>
			<string>SplitScreenGuide</string>
			<key>label</key>
			<string>SPLITSCREEN_GUIDE</string>
			<key>symbol</key>
			<string>book.fill</string>
		</dict>
	</array>
</dict>
</plist>
