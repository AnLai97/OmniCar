<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Split Screen page: OMCSplitScreenController draws the whole page (OMCCardPage). Only the on/off switch stays
     here, so the root page can show "On / Off" (it reads the first switch of every Feature*.plist). -->
<plist version="1.0">
<dict>
	<key>featureLabel</key>
	<string>SPLITSCREEN</string>
	<key>featureOrder</key>
	<integer>30</integer>
	<key>featureController</key>
	<string>OMCSplitScreenController</string>
	<key>featureSymbol</key>
	<string>rectangle.split.2x1.fill</string>
	<key>title</key>
	<string>Split Screen</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SPLITSCREEN_ENABLE</string>
			<key>key</key>
			<string>splitScreenEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
	</array>
</dict>
</plist>
