<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TikTok page. Labels and footers are keys into <lang>.lproj/TikTok.strings; "symbol"/"symbolColor" draw
     the row icon. Keys are the TTK_KEY_* of ../../TikTok.h. PostNotification makes SpringBoard republish the
     state TikTok reads; the page controller publishes it too (TikTok cannot read the plist). -->
<plist version="1.0">
<dict>
	<key>title</key>
	<string>TikTok</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>TIKTOK_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>TIKTOK_ENABLE</string>
			<key>symbol</key>
			<string>power</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>tiktokEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>TIKTOK_SECTION_PLAYBACK</string>
			<key>footerText</key>
			<string>TIKTOK_BACKGROUND_AUDIO_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>TIKTOK_BACKGROUND_AUDIO</string>
			<key>symbol</key>
			<string>headphones</string>
			<key>symbolColor</key>
			<string>#E8457C</string>
			<key>key</key>
			<string>tiktokBackgroundAudio</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>TIKTOK_AUTO_NEXT_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>TIKTOK_AUTO_NEXT</string>
			<key>symbol</key>
			<string>arrow.down.circle.fill</string>
			<key>symbolColor</key>
			<string>#00A6B2</string>
			<key>key</key>
			<string>tiktokAutoNext</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>TIKTOK_SECTION_DISPLAY</string>
			<key>footerText</key>
			<string>TIKTOK_REMOTE_SCROLL_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>TIKTOK_REMOTE_SCROLL</string>
			<key>symbol</key>
			<string>forward.end.fill</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>tiktokRemoteScroll</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>TIKTOK_CLEAR_DISPLAY_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>TIKTOK_CLEAR_DISPLAY</string>
			<key>symbol</key>
			<string>eye.slash.fill</string>
			<key>symbolColor</key>
			<string>#8A47E8</string>
			<key>key</key>
			<string>tiktokClearDisplay</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.anlai.omnicar</string>
			<key>PostNotification</key>
			<string>com.anlai.omnicar/prefschanged</string>
		</dict>
	</array>
</dict>
</plist>
