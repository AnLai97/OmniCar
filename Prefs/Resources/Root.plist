<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Labels and footers are keys into <lang>.lproj/Localizable.strings; "symbol" draws the row icon (or "icon" =
     a 29pt image in the bundle). The master switch lives in the header card and Respring / Language in the nav
     bar (OMCRootListController), so this page is just the apps row and the feature rows. -->
<plist version="1.0">
<dict>
	<key>title</key>
	<string>OmniCar</string>
	<key>items</key>
	<array>
		<!-- APPS: the iPhone apps shown on the car screen through App Bridge (its own page,
		     OMCAppBridgeAppsController in Features/AppBridge/Prefs). -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>APPS_GROUP</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>cellClass</key>
			<string>OMCAppBridgeAppsLinkCell</string>
			<key>detail</key>
			<string>OMCAppBridgeAppsController</string>
			<key>label</key>
			<string>APPS</string>
			<key>symbol</key>
			<string>square.grid.2x2.fill</string>
		</dict>

		<!-- FEATURES: the rows are built at runtime from every Feature*.plist in the bundle
		     (featureLabel / featureIcon or featureSymbol / featureController / featureOrder keys at the top of
		     each one) and inserted after this group cell; each row shows its feature's On / Off. -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>id</key>
			<string>features</string>
			<key>label</key>
			<string>FEATURES_GROUP</string>
			<key>footerText</key>
			<string>FEATURES_FOOTER</string>
		</dict>
	</array>
</dict>
</plist>
